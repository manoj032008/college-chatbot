# ==============================
# Server Configuration
# ==============================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5000

# ==============================
# Authentication Configuration
# ==============================
JWT_SECRET=your_jwt_secret_key_here
# You must create OAuth credentials in Google Cloud Console:
# 1. Go to APIs & Services > Credentials
# 2. Create OAuth client ID (Web application)
# 3. Add Authorized JavaScript origins: http://localhost:5000 AND https://gptproddaturclgchatbot.netlify.app
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com

# ==============================
# Groq AI Configuration (Optional)
# Get your key from: https://console.groq.com
# Used for AI response formatting.
# If not set, chatbot uses built-in fallback responses.
# ==============================
GROQ_API_KEY=your_groq_api_key_here

# ==============================
# Notes
# ==============================
# This project uses a SQLite database for persistent user accounts.
# Ensure that JWT_SECRET and GOOGLE_CLIENT_ID are configured in production.
# Simply run: npm start
