# ==============================
# Server Configuration
# ==============================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5000

# ==============================
# Groq AI Configuration (Optional)
# Get your key from: https://console.groq.com
# Used for AI response formatting.
# If not set, chatbot uses built-in fallback responses.
# ==============================
GROQ_API_KEY=your_groq_api_key_here

# ==============================
# Notes
# ==============================
# This project uses a JSON Knowledge Base.
# No database, no authentication, no external dependencies required.
# Simply run: npm start
